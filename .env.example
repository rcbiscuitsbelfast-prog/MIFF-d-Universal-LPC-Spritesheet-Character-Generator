# LPC Avatar Builder - Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=3000

# Asset Paths
SPRITESHEETS_PATH=/opt/render/project/src/spritesheets
ASSETS_PATH=/opt/render/project/src/assets/lpc
PERSISTENT_DISK_PATH=/opt/render/project/data

# Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FORMATS=.png,.json

# Logging
LOG_LEVEL=info

# CORS Configuration (optional)
ALLOWED_ORIGINS=*

# Rate Limiting (optional)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
